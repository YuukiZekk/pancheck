# 复制为 .env 后按你的 NAS 实际路径修改

# 面板端口
PANEL_PORT=8760
# 访问口令（强烈建议设置；留空 = 局域网里谁都能打开。用户名随便填）
PANEL_PASSWORD=

# 必填：CloudDrive2 的配置目录（里面有 dir_cache.sqlite，面板默认就读它，不向网盘发请求）
CD2_CONFIG_HOST=/volume1/docker/clouddrive2/config
# 必填：Emby 的 data 目录（里面有 library.db）
EMBY_DATA_HOST=/volume1/docker/emby/config/data

# 可选：CloudDrive2 在宿主机上的挂载根。只有「遍历挂载目录」兜底模式才需要
# CD2_MOUNT_HOST=/volume1/CloudNAS/CloudDrive
