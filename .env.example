# 复制为 .env 后按你的 NAS 实际路径修改
# 面板端口
PANEL_PORT=8760
# 访问口令（留空=不设口令；用户名随便填）
PANEL_PASSWORD=
# CloudDrive2 在宿主机上的挂载根（里面能看到 115 等网盘目录）
CD2_MOUNT_HOST=/volume1/CloudNAS/CloudDrive
# CloudDrive2 的配置目录（含 dir_cache.sqlite，只用于识别回显，可不填）
CD2_CONFIG_HOST=/volume1/docker/clouddrive2/config
# Emby 的 data 目录（含 library.db）
EMBY_DATA_HOST=/volume1/docker/emby/config/data
